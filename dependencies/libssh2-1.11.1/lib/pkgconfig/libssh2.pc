prefix=D:/SUMOLibraries_MSVC/dependencies/libssh2-1.11.1
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: libssh2
URL: https://libssh2.org/
Description: Library for SSH-based communication
Version: 1.11.1
Requires: 
Requires.private: libcrypto,zlib
Libs: -L${libdir} -lssh2 
Libs.private: -LD:/SUMOLibraries_MSVC/dependencies/openssl-4.0.1/lib -lws2_32 -lcrypto -lcrypt32 -lbcrypt -loptimized D:/SUMOLibraries_MSVC/zlib-1.3.2/lib/z.lib -ldebug D:/SUMOLibraries_MSVC/zlib-1.3.2/lib/zd.lib
Cflags: -I${includedir}
