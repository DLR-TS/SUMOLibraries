prefix=D:/SUMOLibraries/dependencies/curl-8.20.0
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include
supported_protocols="DICT FILE FTP FTPS GOPHER GOPHERS HTTP HTTPS IMAP IMAPS IPFS IPNS LDAP LDAPS MQTT MQTTS POP3 POP3S RTSP SMTP SMTPS TELNET TFTP WS WSS"
supported_features="alt-svc AsynchDNS HSTS HTTPS-proxy IDN IPv6 Largefile libz SSL threadsafe TLS-SRP UnixSockets zstd"

Name: libcurl
URL: https://curl.se/
Description: Library to transfer files with HTTP, FTP, etc.
Version: 8.20.0
Requires: 
Requires.private: openssl,zlib,libzstd
Libs: -L${libdir} -lcurl 
Libs.private: -LD:/SUMOLibraries/dependencies/openssl-4.0.0/lib -lssl -lcrypto -lcrypto D:/SUMOLibraries/zlib-1.3.2/lib/z.lib D:/SUMOLibraries/dependencies/zstd-1.5.7/lib/zstd.lib -lwldap32 -lnormaliz -lbcrypt -ladvapi32 -lcrypt32 -lws2_32 -liphlpapi
Cflags: -I${includedir} 
Cflags.private: -DCURL_STATICLIB
