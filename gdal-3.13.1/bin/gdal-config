#!/bin/sh
CONFIG_LIBS="-LIBPATH:D:/SUMOLibraries_MSVC/gdal-3.13.1/lib gdal"
CONFIG_DEP_LIBS="D:/SUMOLibraries_MSVC/gettext-1.0/lib/iconv.dll.lib D:/SUMOLibraries_MSVC/gettext-1.0/lib/charset.dll.lib D:/SUMOLibraries_MSVC/dependencies/openssl-4.0.1/lib/libssl.lib D:/SUMOLibraries_MSVC/dependencies/openssl-4.0.1/lib/libcrypto.lib crypt32 D:/SUMOLibraries_MSVC/dependencies/compression/lz4-1.10.0/lib/lz4.lib wbemuuid ws2_32 D:/SUMOLibraries_MSVC/dependencies/compression/zstd-1.5.7/lib/zstdd.lib D:/SUMOLibraries_MSVC/dependencies/image/libwebp-1.6.0/lib/libwebp.lib D:/SUMOLibraries_MSVC/dependencies/pcre2-10.47/lib/pcre2-8.lib D:/SUMOLibraries_MSVC/libspatialite-5.1.0/lib/spatialite_i.lib D:/SUMOLibraries_MSVC/dependencies/sqlite-3.53.1/lib/sqlite3.lib D:/SUMOLibraries_MSVC/xerces-c-3.3.0/lib/xerces-c_3.lib legacy_stdio_definitions.lib odbccp32.lib D:/SUMOLibraries_MSVC/dependencies/gis/freexl-2.0.0/lib/freexl_i.lib D:/SUMOLibraries_MSVC/dependencies/libexpat-2.8.1/lib/libexpatd.lib D:/SUMOLibraries_MSVC/dependencies/libxml2-2.15.3/lib/libxml2.lib D:/SUMOLibraries_MSVC/geos-3.14.1/lib/geos_cd.lib D:/SUMOLibraries_MSVC/dependencies/curl-8.20.0/lib/libcurld_imp.lib psapi D:/SUMOLibraries_MSVC/proj-9.8.1/lib/proj_d.lib"
CONFIG_PREFIX="D:/SUMOLibraries_MSVC/gdal-3.13.1"
CONFIG_CFLAGS="-ID:/SUMOLibraries_MSVC/gdal-3.13.1/include"
CONFIG_DATA="D:/SUMOLibraries_MSVC/gdal-3.13.1/share/gdal"
CONFIG_VERSION="3.13.1"
CONFIG_GNM_ENABLED=yes
CONFIG_FORMATS="JPEG raw GTIFF MEM vrt Derived GTI LIBERTIFF HFA NITF GXF AAIGrid CEOS SAR_CEOS DTED JDEM Envisat L1B RS2 ILWIS RMF Leveller SRTMHGT IDRISI GSG ERS PALSARJaxa DIMAP GFF COSAR PDS ADRG COASP TSX Terragen MSGN TIL northwood SAGA XYZ ESRIC HF2 KMLSUPEROVERLAY CTG ZMap NGSGEOID IRIS MAP CALS SAFE SENTINEL2 PRF MRF WMTS GRIB BMP TGA STACTA SNAP_TIFF BSB AIGrid USGSDEM AirSAR PCIDSK SIGDEM RIK STACIT PDF RCM GDALG E57 PNG GIF WCS HTTP Zarr DAAS EEDA PLMOSAIC WMS OGCAPI WEBP PCRaster MiraMon GeoJSON TAB Shape KML VRT AVC GML CSV DGN GMT NTF S57 Tiger GeoRSS DXF PGDump GPSBabel EDIGEO SXF OpenFileGDB WAsP Selafin JML VDV FlatGeobuf MapML ADBC MiraMon AIVector JSONFG GPX GMLAS CSW NAS PLSCENES WFS OAPIF NGW Elastic Idrisi PDS SQLite GeoPackage OSM VFK AmigoCloud Carto ILI MSSQLSpatial ODBC PGeo XLSX XLS CAD GTFS ODS LVBAG"
CONFIG_PLUGINDIR="D:/SUMOLibraries_MSVC/gdal-3.13.1/lib/gdalplugins"
usage()

{
	cat <<EOF
Usage: gdal-config [OPTIONS]
Options:
	[--prefix[=DIR]]
	[--libs]
	[--dep-libs]
	[--cflags]
	[--datadir]
	[--version]
	[--ogr-enabled]
	[--gnm-enabled]
	[--formats]
	[--plugindir]
EOF
	exit $1
}

if test $# -eq 0; then
	usage 1 1>&2
fi

case $1 in
  --libs)
    echo $CONFIG_LIBS
    ;;

  --dep-libs)
    echo $CONFIG_DEP_LIBS
    ;;

  --cflags)
    echo $CONFIG_CFLAGS
    ;;

  --datadir)
    echo $CONFIG_DATA
    ;;

  --prefix)
    echo $CONFIG_PREFIX
    ;;

  --version)
    echo $CONFIG_VERSION
    ;;

  --ogr-enabled)
    echo yes
    ;;

  --gnm-enabled)
    echo $CONFIG_GNM_ENABLED
    ;;

  --formats)
    echo $CONFIG_FORMATS
    ;;

  --plugindir)
    echo $CONFIG_PLUGINDIR
    ;;

  *)
    usage 1 1>&2
    ;;

esac
